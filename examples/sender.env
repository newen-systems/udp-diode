# Low-side sender, strict one-way mode (no receipt socket is opened).
DIODE_MODE=sender
DIODE_FEEDBACK=off
DIODE_STATE_DIR=/var/lib/diode
DIODE_API_TOKEN_FILE=/run/secrets/api_token
DIODE_DATA_KEY_FILE=/run/secrets/data_key
# The soft one-way relay on the low network (see compose.yml).
DIODE_DATA_PEER=172.31.10.5:9400
DIODE_MAX_BITRATE_MBPS=200
# Repeat the whole object once: without receipts this is the only loss insurance.
DIODE_PASSES=1
DIODE_PARITY_GROUP=0
