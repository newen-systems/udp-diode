# High-side receiver, strict one-way mode (no receipt socket is opened).
DIODE_MODE=receiver
DIODE_FEEDBACK=off
DIODE_STATE_DIR=/var/lib/diode
DIODE_API_TOKEN_FILE=/run/secrets/api_token
DIODE_DATA_KEY_FILE=/run/secrets/data_key
DIODE_DELIVERY_URL=http://sink:8081/ingest
DIODE_RAM_MAX_BYTES=67108864
