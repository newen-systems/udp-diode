DIODE_MODE=sender
DIODE_FEEDBACK=off
DIODE_STATE_DIR=/var/lib/diode
DIODE_API_TOKEN_FILE=/run/secrets/diode/api_token
DIODE_DATA_KEY_FILE=/run/secrets/diode/data_key
DIODE_DATA_PEER=udp-diode-receiver:9400
DIODE_MAX_BITRATE_MBPS=200
# Strict one-way: single pass with interleaved parity families (results/ABSORB-RESEARCH.md).
DIODE_PASSES=1
DIODE_FEC_FAMILIES=12x240,12x248,12x256
DIODE_PARITY_GROUP=0
